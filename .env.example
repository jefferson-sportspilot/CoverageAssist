# Public site URL for this app only (metadata / absolute links). Do not reuse NEXT_PUBLIC_APP_URL from other products.
# Local dev: http://localhost:3000  |  Production: https://your-coverage-assist-domain
NEXT_PUBLIC_COVERAGE_ASSIST_URL=http://localhost:3000

# n8n webhook URL (POST JSON — same contract as static CoverageAssistAI.html)
# Default matches the original app if unset.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n-production-bba0.up.railway.app/webhook/coverage-assist

# Feedback webhook URL (client-side POST for user feedback logs)
NEXT_PUBLIC_FEEDBACK_WEBHOOK_URL=https://n8n-production-bba0.up.railway.app/webhook/coverage-assist-feedback

# Serper API key (server-only — used by /api/serp-context for optional "Fetch snippets")
# https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Optional legacy fallback supported by code:
# SERPAPI_KEY=your_serpapi_key_here
